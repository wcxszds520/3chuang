  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 100rpx;
}

.inspector-content {
  background: #FFFFFF;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18);
  animation: inspectorSlideDown 280ms cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes inspectorSlideDown {
  from { transform: translateY(-80rpx); opacity: 0; }
  to   { transform: translateY(0);      opacity: 1; }
}

.inspector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(10, 15, 31, 0.06);
}

.inspector-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0A0F1F;
}

.inspector-close {
  font-size: 36rpx;
  color: #9CA3B0;
  line-height: 1;
}

.inspector-body { padding: 16rpx 24rpx; }

.inspector-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(10, 15, 31, 0.04);
}

.inspector-row:last-child { border-bottom: none; }

.inspector-label {
  font-size: 24rpx;
  color: #5A6478;
  font-weight: 500;
}

.inspector-value {
  font-size: 24rpx;
  color: #0A0F1F;
  font-weight: 600;
  text-align: right;
