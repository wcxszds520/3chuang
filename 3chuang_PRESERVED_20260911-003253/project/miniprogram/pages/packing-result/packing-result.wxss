}

.advice-text {
  font-size: 24rpx;
  color: #2A4F7F;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

.compliance-footer {
  margin-top: 18rpx;
  padding-top: 16rpx;
