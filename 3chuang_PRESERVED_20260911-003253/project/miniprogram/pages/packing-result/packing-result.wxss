}

.timestamp-text { font-size: 20rpx; color: #9CA3B0; }

.compliance-actions {
  padding: 20rpx 0;
  display: flex;
  justify-content: center;
}

.recheck-btn {
  padding: 14rpx 36rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 100rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.25);
  transition: transform 200ms ease;
}

.recheck-btn:active { transform: scale(0.96); }

cover-view { box-sizing: border-box; }

/* ========================================
   15. 叙事加载遮罩
   ======================================== */
.narrative-loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(0, 122, 255, 0.18);
  border-top-color: #007AFF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0%   { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #FFFFFF;
  text-align: center;
  padding: 0 32rpx;
  line-height: 1.6;
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
