/* ========================================
   13. 生成按钮 + 生成中 Loading
   ======================================== */
.action-section {
  padding: 4rpx 0;
}

.generate-btn {
  width: 100%;
  background: linear-gradient(135deg, #007AFF 0%, #00C2A8 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 122, 255, 0.25);
  font-weight: 700;
  letter-spacing: 1rpx;
  transition: transform 200ms ease;
}

.generate-btn:active { transform: scale(0.97); }

.generate-btn.disabled {
  background: #E5E7EB;
  color: #9CA3B0;
  box-shadow: none;
}

.generating-section {
  display: flex;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.generating-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  padding: 60rpx 40rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(10, 15, 31, 0.08);
  border: 1rpx solid rgba(10, 15, 31, 0.04);
  width: 100%;
  animation: generatingEnter 280ms ease-out forwards;
}

@keyframes generatingEnter {
  from { opacity: 0; transform: scale(0.95) translateY(20rpx); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

.generating-ring-container {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.generating-ring {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(0, 122, 255, 0.10);
  border-top-color: #007AFF;
  border-right-color: rgba(0, 122, 255, 0.5);
  animation: generatingRotate 1200ms linear infinite;
}

.generating-ring-inner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #007AFF;
  animation: generatingPulse 1500ms ease-in-out infinite;
  box-shadow: 0 0 24rpx rgba(0, 122, 255, 0.5);
}

@keyframes generatingRotate {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

@keyframes generatingPulse {
  0%, 100% { transform: scale(0.6); opacity: 0.4; }
  50%      { transform: scale(1);   opacity: 1; }
}

.generating-text {
  font-size: 26rpx;
  color: #5A6478;
  font-weight: 500;
  text-align: center;
  animation: generatingTextFade 2s ease-in-out infinite;
}

@keyframes generatingTextFade {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.generating-progress {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.generating-progress-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(0, 122, 255, 0.10);
  border-radius: 100rpx;
  overflow: hidden;
}

.generating-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #007AFF, #4DA8FF);
  border-radius: 100rpx;
  transition: width 500ms ease;
  position: relative;
}

.generating-progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: progressShimmer 1.5s infinite;
}

@keyframes progressShimmer {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.generating-progress-hint {
  font-size: 22rpx;
  color: #9CA3B0;
}

.no-container-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #9CA3B0;
  font-size: 26rpx;
}

.select-container-btn {
  margin-top: 24rpx;
  width: 300rpx;
  background: #007AFF;
  color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.25);
}

/* ========================================
   14. AI 合规报告弹窗
   ======================================== */
.compliance-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10000;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 100rpx 32rpx 32rpx;
}

.compliance-content-wrapper {
  background: #FFFFFF;
  border-radius: 24rpx;
  width: 100%;
  max-width: 650rpx;
  min-height: 200rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18);
  animation: complianceSlideUp 280ms ease-out;
  box-sizing: border-box;
}

@keyframes complianceSlideUp {
  from { transform: translateY(80rpx); opacity: 0; }
  to   { transform: translateY(0);     opacity: 1; }
}

.compliance-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(10, 15, 31, 0.06);
  background: linear-gradient(135deg, rgba(0, 194, 168, 0.08) 0%, rgba(0, 122, 255, 0.04) 100%);
  border-radius: 24rpx 24rpx 0 0;
  flex-shrink: 0;
}

.compliance-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0A0F1F;
}

.compliance-header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.refresh-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 122, 255, 0.10);
  border-radius: 50%;
  font-size: 24rpx;
  transition: all 200ms ease;
}

.refresh-btn:active {
  transform: scale(0.9);
  background: rgba(0, 122, 255, 0.18);
}

.refresh-btn.loading {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.compliance-close {
  font-size: 40rpx;
  color: #9CA3B0;
  line-height: 1;
}

.compliance-body-scroll {
  flex: 1;
  height: calc(80vh - 160rpx);
  max-height: 1000rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.compliance-status-card {
  background: #F8FAFC;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
  border-left: 6rpx solid #00C2A8;
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.status-text { font-size: 28rpx; font-weight: 700; }
.status-score { font-size: 40rpx; font-weight: 800; }
.status-badge { margin-top: 10rpx; }

.badge-text {
  display: inline-block;
  padding: 6rpx 14rpx;
  background: rgba(255, 149, 0, 0.10);
  color: #FF9500;
  font-size: 22rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.compliance-section { margin-bottom: 18rpx; }

.compliance-table {
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(10, 15, 31, 0.06);
}

.table-header {
  display: flex;
  background: #F8FAFC;
  border-bottom: 2rpx solid rgba(10, 15, 31, 0.06);
}

.table-body { display: flex; flex-direction: column; }

.table-row {
  display: flex;
  border-bottom: 1rpx solid rgba(10, 15, 31, 0.04);
}

.table-row:last-child { border-bottom: none; }

.table-cell {
  padding: 14rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-word;
}

.header-cell {
  font-weight: 700;
  color: #0A0F1F;
  font-size: 22rpx;
}

.dimension-col { flex: 2; min-width: 160rpx; }
.standard-col { flex: 1.5; min-width: 120rpx; text-align: center; }
.actual-col { flex: 1.5; min-width: 120rpx; text-align: center; }
.result-col { flex: 1; min-width: 100rpx; text-align: center; font-weight: 700; }

.result-PASS    { color: #00B388; }
.result-FAIL    { color: #FF4D4F; }
.result-WARNING { color: #FF9500; }
.result-PENDING { color: #9CA3B0; }

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0A0F1F;
  margin-bottom: 12rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid #00C2A8;
}

.issue-list {
  background: rgba(255, 77, 79, 0.06);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.issue-item { padding: 6rpx 0; }
.issue-text {
  font-size: 22rpx;
  color: #FF4D4F;
  line-height: 1.6;
}

.advice-box {
  background: rgba(0, 122, 255, 0.06);
  border-radius: 12rpx;
  padding: 18rpx;
