-### 数据模型类设计
-
-#### Cargo（货物模型）
-
-```javascript
-class Cargo {
-  constructor({
-    cargoId,
-    name,
-    length,
-    width,
-    height,
-    weight,
-    quantity,
-    stackable = true,
-    maxStackLayers = 999,
-    canInvert = true,
-    canLayFlat = true
-  }) {
-    this.cargoId = cargoId;
-    this.name = name;
-    this.length = length;  // 毫米
-    this.width = width;    // 毫米
-    this.height = height;  // 毫米
-    this.weight = weight;  // 千克
-    this.quantity = quantity;
-    this.stackable = stackable;
-    this.maxStackLayers = maxStackLayers;
-    this.canInvert = canInvert;
-    this.canLayFlat = canLayFlat;
-  }
-  
-  // 计算单件货物体积（立方毫米）
-  getVolume() {
-    return this.length * this.width * this.height;
-  }
-  
-  // 计算总体积（立方毫米）
-  getTotalVolume() {
-    return this.getVolume() * this.quantity;
-  }
-  
-  // 计算总重量（千克）
-  getTotalWeight() {
-    return this.weight * this.quantity;
-  }
-  
-  // 验证货物数据有效性
-  validate() {
-    if (this.length <= 0 || this.width <= 0 || this.height <= 0) {
-      throw new Error('货物尺寸必须为正数');
-    }
-    if (this.weight <= 0) {
-      throw new Error('货物重量必须为正数');
-    }
-    if (this.quantity <= 0) {
-      throw new Error('货物数量必须为正数');
-    }
-    return true;
-  }
-}
-```
-
-#### ContainerType（柜型模型）
-
-```javascript
-class ContainerType {
-  constructor({
-    typeId,
-    name,
-    innerLength,
-    innerWidth,
-    innerHeight,
-    maxWeight,
-    description
-  }) {
-    this.typeId = typeId;
-    this.name = name;
-    this.innerLength = innerLength;  // 毫米
-    this.innerWidth = innerWidth;    // 毫米
-    this.innerHeight = innerHeight;  // 毫米
-    this.maxWeight = maxWeight;      // 千克
-    this.description = description;
-  }
-  
-  // 计算集装箱容积（立方毫米）
-  getVolume() {
-    return this.innerLength * this.innerWidth * this.innerHeight;
-  }
-  
-  // 检查货物是否超出柜型尺寸
-  canFitCargo(cargo) {
-    const dimensions = [cargo.length, cargo.width, cargo.height].sort((a, b) => b - a);
-    const containerDimensions = [this.innerLength, this.innerWidth, this.innerHeight].sort((a, b) => b - a);
-    
-    for (let i = 0; i < 3; i++) {
-      if (dimensions[i] > containerDimensions[i]) {
-        return false;
-      }
-    }
-    return true;
-  }
-}
-```
-
-#### PackingPlan（装箱方案模型）
-
-```javascript
-class PackingPlan {
-  constructor({
