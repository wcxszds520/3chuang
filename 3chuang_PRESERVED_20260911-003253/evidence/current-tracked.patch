-### 3. NingboPortComplianceChecker（新建）
-
-新建`backend/services/NingboPortComplianceChecker.js`，实现六维合规校验：
-
-```javascript
-class NingboPortComplianceChecker {
-  constructor() {
-    // 合规阈值
-    this.THRESHOLDS = {
-      COG_FRONT_BACK_MAX: 0.10,    // 前后偏载最大10%
-      COG_LEFT_RIGHT_MAX: 0.05,    // 左右偏载最大5%
-      WEIGHT_20GP_MAX: 28000,      // 20GP最大载重28吨
-      WEIGHT_40GP_MAX: 26000,      // 40GP/HQ最大载重26吨
-      SCORE_EXCELLENT: 90,         // 优秀分数线
-      SCORE_WARNING: 60            // 警告分数线
-    };
-  }
-  
-  /**
-   * 校验出货顺序合规性
-   * @param {Object} packingPlan - 装箱方案
-   * @returns {Object} 校验结果
-   */
-  validateShippingOrder(packingPlan) {
-    const violations = [];
-    const loadedCargo = packingPlan.loadedCargo;
-    
-    // 检查装柜顺序是否为卸货顺序的反向
-    for (let i = 0; i < loadedCargo.length - 1; i++) {
-      const cargo1 = loadedCargo[i];
-      const cargo2 = loadedCargo[i + 1];
-      
-      // 如果cargo1的unloadingOrder更大，但packingOrder更小，则违规
-      if (cargo1.cargo.unloadingOrder > cargo2.cargo.unloadingOrder &&
-          cargo1.cargo.packingOrder < cargo2.cargo.packingOrder) {
-        violations.push({
-          cargo1: cargo1.cargo.name,
-          cargo2: cargo2.cargo.name,
-          issue: `${cargo1.cargo.name}应在${cargo2.cargo.name}之后装柜`
-        });
-      }
-      
-      // 检查Z坐标是否符合ETA顺序（ETA早的Z坐标应更大）
-      if (cargo1.cargo.eta < cargo2.cargo.eta &&
-          cargo1.position.z < cargo2.position.z) {
-        violations.push({
-          cargo1: cargo1.cargo.name,
-          cargo2: cargo2.cargo.name,
-          issue: `${cargo1.cargo.name}（ETA更早）应放在更靠近门端的位置`
-        });
-      }
-    }
-    
-    // 计算合规分数（100分制）
-    const score = Math.max(0, 100 - violations.length * 10);
-    
-    return {
-      dimension: '出货顺序',
-      score: score,
-      violations: violations,
-      passed: violations.length === 0
-    };
-  }
-  
-  /**
-   * 校验重心偏载
-   * @param {Object} packingPlan - 装箱方案
-   * @param {Object} containerType - 集装箱类型
-   * @returns {Object} 校验结果
-   */
-  validateCOGOffset(packingPlan, containerType) {
-    const cog = packingPlan.centerOfGravity;
-    const containerCenter = {
-      x: containerType.innerLength / 2,
-      y: containerType.innerWidth / 2,
-      z: containerType.innerHeight / 2
-    };
-    
-    // 计算前后偏移（Z轴）
-    const frontBackOffset = Math.abs(cog.z - containerCenter.z) / containerCenter.z;
-    
-    // 计算左右偏移（X轴）
-    const leftRightOffset = Math.abs(cog.x - containerCenter.x) / containerCenter.x;
-    
-    const violations = [];
-    
-    if (frontBackOffset > this.THRESHOLDS.COG_FRONT_BACK_MAX) {
-      violations.push({
-        type: 'front_back_offset',
-        value: (frontBackOffset * 100).toFixed(2) + '%',
-        threshold: (this.THRESHOLDS.COG_FRONT_BACK_MAX * 100) + '%',
-        suggestion: '建议调整货物位置，将重货向' + (cog.z > containerCenter.z ? '前' : '后') + '移动'
-      });
-    }
-    
-    if (leftRightOffset > this.THRESHOLDS.COG_LEFT_RIGHT_MAX) {
-      violations.push({
-        type: 'left_right_offset',
-        value: (leftRightOffset * 100).toFixed(2) + '%',
-        threshold: (this.THRESHOLDS.COG_LEFT_RIGHT_MAX * 100) + '%',
-        suggestion: '建议调整货物位置，将重货向' + (cog.x > containerCenter.x ? '左' : '右') + '移动'
-      });
-    }
-    
-    // 计算合规分数
-    const score = Math.max(0, 100 - violations.length * 20);
-    
-    return {
-      dimension: '重心偏载',
-      score: score,
-      frontBackOffset: (frontBackOffset * 100).toFixed(2) + '%',
-      leftRightOffset: (leftRightOffset * 100).toFixed(2) + '%',
-      violations: violations,
-      passed: violations.length === 0
-    };
-  }
-  
-  /**
-   * 校验超重
-   * @param {Object} packingPlan - 装箱方案
-   * @param {Object} containerType - 集装箱类型
-   * @returns {Object} 校验结果
-   */
-  validateWeight(packingPlan, containerType) {
-    const totalWeight = packingPlan.totalWeight;
-    let maxWeight = this.THRESHOLDS.WEIGHT_40GP_MAX;
-    
-    if (containerType.typeId === '20GP') {
-      maxWeight = this.THRESHOLDS.WEIGHT_20GP_MAX;
-    }
-    
-    const violations = [];
-    
-    if (totalWeight > maxWeight) {
-      violations.push({
-        type: 'overweight',
-        totalWeight: totalWeight + 'kg',
-        maxWeight: maxWeight + 'kg',
-        excess: (totalWeight - maxWeight) + 'kg',
-        suggestion: '建议减少货物数量或更换更大柜型'
-      });
-    }
-    
-    // 计算合规分数
-    const score = totalWeight <= maxWeight ? 100 : Math.max(0, 100 - (totalWeight - maxWeight) / maxWeight * 100);
-    
-    return {
-      dimension: '超重检查',
-      score: score,
-      totalWeight: totalWeight + 'kg',
-      maxWeight: maxWeight + 'kg',
-      violations: violations,
-      passed: violations.length === 0
-    };
-  }
-  
-  /**
-   * 校验堆叠合规性
-   * @param {Object} packingPlan - 装箱方案
-   * @returns {Object} 校验结果
-   */
-  validateStacking(packingPlan) {
-    const violations = [];
-    const loadedCargo = packingPlan.loadedCargo;
-    
-    // 检查堆叠层数
-    for (let cargo of loadedCargo) {
-      if (cargo.stackLevel > cargo.cargo.maxStackLayers) {
-        violations.push({
-          cargo: cargo.cargo.name,
