-    // 按报关单号分组
-    const groups = {};
-    loadedCargo.forEach(cargo => {
-      if (cargo.cargo.customsDeclaration) {
-        const decl = cargo.cargo.customsDeclaration;
-        if (!groups[decl]) {
-          groups[decl] = [];
-        }
-        groups[decl].push(cargo);
-      }
-    });
-    
-    // 检查每组货物是否集中放置
-    for (let decl in groups) {
