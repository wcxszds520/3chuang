-### SKU Adjacency Scoring Algorithm
-
-```javascript
-calculateSKUAdjacencyScore(x, y, z, l, w, h, cargo) {
-  let adjacentCount = 0;
-
-  for (const placed of this.placedCargo) {
-    // Only count same SKU
-    if (placed.sku !== cargo.sku) continue;
-
-    const box1 = { xMin: x, xMax: x + l, yMin: y, yMax: y + h, zMin: z, zMax: z + w };
-    const box2 = placed.getBoundingBox();
-
-    // Check X-axis adjacency
-    const xAdjacent = Math.abs(box1.xMax - box2.xMin) < 1 || Math.abs(box2.xMax - box1.xMin) < 1;
-    const yOverlap = box1.yMin < box2.yMax && box1.yMax > box2.yMin;
-    const zOverlap = box1.zMin < box2.zMax && box1.zMax > box2.zMin;
-    if (xAdjacent && yOverlap && zOverlap) {
-      adjacentCount++;
-      continue;
-    }
-
-    // Check Y-axis adjacency
-    const yAdjacent = Math.abs(box1.yMax - box2.yMin) < 1 || Math.abs(box2.yMax - box1.yMin) < 1;
-    const xOverlap2 = box1.xMin < box2.xMax && box1.xMax > box2.xMin;
-    const zOverlap2 = box1.zMin < box2.zMax && box1.zMax > box2.zMin;
-    if (yAdjacent && xOverlap2 && zOverlap2) {
-      adjacentCount++;
-      continue;
-    }
-
-    // Check Z-axis adjacency
-    const zAdjacent = Math.abs(box1.zMax - box2.zMin) < 1 || Math.abs(box2.zMax - box1.zMin) < 1;
-    const xOverlap3 = box1.xMin < box2.xMax && box1.xMax > box2.xMin;
-    const yOverlap3 = box1.yMin < box2.yMax && box1.yMax > box2.yMin;
-    if (zAdjacent && xOverlap3 && yOverlap3) {
-      adjacentCount++;
-    }
-  }
-
-  // Return bonus score (more adjacent = higher bonus)
-  return adjacentCount * this.config.skuAdjacencyWeight;
-}
-```
