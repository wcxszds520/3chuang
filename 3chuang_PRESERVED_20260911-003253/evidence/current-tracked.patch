-## Algorithm Details
-
-### Enhanced Placement Algorithm
-
-核心算法继承v26.2的全局极点搜索,增加四层验证和评分:
-
-```javascript
-placeCargoGlobally(cargo) {
-  let bestPlacement = null;
-  let bestScore = Infinity;
-
-  const rotations = this.get6DOFRotations(cargo, true);
-
-  for (const ep of this.extremePoints) {
-    for (const rotation of rotations) {
-      const { l, w, h, isForced } = rotation;
-
-      // Layer 1: Basic geometric checks (inherited from v26.2)
-      if (!this.fitsInContainer(ep.x, ep.y, ep.z, l, w, h)) continue;
-      if (this.hasCollision(ep.x, ep.y, ep.z, l, w, h)) continue;
-
-      // Layer 2: Packaging strength validation (NEW)
-      if (this.config.enablePackagingValidation) {
-        if (!this.validatePackagingStrength(ep.x, ep.y, ep.z, l, w, h, cargo)) {
-          if (this.config.debugMode) {
-            console.log(`❌ Packaging strength violation at (${ep.x}, ${ep.y}, ${ep.z})`);
-          }
-          continue;
-        }
-      }
-
-      // Layer 3: Soft isolation LIFO check (NEW)
-      if (this.config.enableSoftIsolationLIFO) {
-        if (!this.checkSoftIsolationLIFO(ep.x, ep.y, ep.z, l, w, h, cargo)) {
-          if (this.config.debugMode) {
-            console.log(`❌ LIFO violation at (${ep.x}, ${ep.y}, ${ep.z})`);
-          }
-          continue;
-        }
-      }
-
-      // Layer 4: Calculate enhanced score
-      let score = this.calculateBaseScore(ep, cargo); // v26.2 base score
-
-      // Add SKU adjacency bonus (NEW)
-      if (this.config.enableSKUAggregation) {
-        const skuBonus = this.calculateSKUAdjacencyScore(ep.x, ep.y, ep.z, l, w, h, cargo);
-        score -= skuBonus; // Lower score is better
-      }
-
-      // Add zonal balancing bonus (NEW)
-      if (this.config.enableZonalBalancing && cargo.isHeavyCargo()) {
-        const zonalBonus = this.calculateZonalBalancingScore(ep.x, ep.y, ep.z, l, w, h, cargo);
-        score -= zonalBonus; // Lower score is better
-      }
-
-      if (score < bestScore) {
-        bestScore = score;
-        bestPlacement = { x: ep.x, y: ep.y, z: ep.z, l, w, h, isForced };
-      }
-    }
-  }
-
-  if (!bestPlacement) return false;
-
-  // Place cargo and update state
-  this.loadingIndex++;
-  const placement = new PlacementRecord(cargo, bestPlacement, this.loadingIndex);
-  this.placedCargo.push(placement);
-  this.updateExtremePoints(bestPlacement);
-  
-  // Update zonal weights (NEW)
-  if (this.config.enableZonalBalancing) {
-    this.updateZonalWeights(placement, cargo);
-  }
-
-  // Update SKU adjacency map (NEW)
-  if (this.config.enableSKUAggregation) {
-    this.updateSKUAdjacencyMap(placement, cargo);
-  }
-
-  return true;
-}
-```
-
-### Packaging Strength Validation Algorithm
-
-```javascript
-validatePackagingStrength(x, y, z, l, w, h, cargo) {
-  // Rule 1: Check support ratio (inherited from v26.2, enhanced to 80%)
-  if (y > 0) {
-    const supportRatio = this.calculateSupportRatio(x, y, z, l, w, h);
-    if (supportRatio < 0.80) {
-      return false;
-    }
-  }
-
-  // Rule 2: Find cargo directly below
-  const cargoBelow = this.placedCargo.filter(placed => {
-    const isDirectlyBelow = Math.abs(placed.position.y + placed.dimensions.h - y) < 1;
-    const xOverlap = placed.position.x < x + l && placed.position.x + placed.dimensions.l > x;
-    const zOverlap = placed.position.z < z + w && placed.position.z + placed.dimensions.w > z;
-    return isDirectlyBelow && xOverlap && zOverlap;
-  });
-
-  // Rule 3: Heavy cargo cannot be placed on carton
-  if (cargo.isHeavyCargo()) {
-    for (const below of cargoBelow) {
-      if (below.packagingType === 'carton') {
-        return false;
-      }
-    }
-  }
-
-  // Rule 4: Check stack layers for carton below
-  for (const below of cargoBelow) {
-    if (below.packagingType === 'carton') {
-      const layersAbove = this.countLayersAbove(below);
-      if (layersAbove >= below.cargo.getMaxStackLayers()) {
-        return false;
-      }
-    }
-  }
-
-  return true;
-}
-
-countLayersAbove(placement) {
-  let maxLayers = 0;
-  const queue = [placement];
-  const visited = new Set();
-
-  while (queue.length > 0) {
-    const current = queue.shift();
-    if (visited.has(current)) continue;
-    visited.add(current);
-
-    const cargoAbove = this.placedCargo.filter(placed => {
-      const isDirectlyAbove = Math.abs(current.position.y + current.dimensions.h - placed.position.y) < 1;
-      const xOverlap = current.position.x < placed.position.x + placed.dimensions.l && 
-                      current.position.x + current.dimensions.l > placed.position.x;
-      const zOverlap = current.position.z < placed.position.z + placed.dimensions.w && 
-                      current.position.z + current.dimensions.w > placed.position.z;
-      return isDirectlyAbove && xOverlap && zOverlap;
-    });
-
-    if (cargoAbove.length === 0) {
-      maxLayers = Math.max(maxLayers, current.stackLevel + 1);
-    } else {
-      cargoAbove.forEach(above => {
-        above.stackLevel = current.stackLevel + 1;
-        queue.push(above);
-      });
-    }
-  }
-
-  return maxLayers;
-}
-```
