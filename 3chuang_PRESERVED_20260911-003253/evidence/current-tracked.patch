-### 1. 货物排序策略
-
-#### 多维度评分排序
-
-为了最大化空间利用率，我们采用多维度评分系统对货物进行排序：
-
-```javascript
-function calculateCargoScore(cargo) {
-  const volume = cargo.length * cargo.width * cargo.height;
-  const weight = cargo.weight;
-  const stackability = cargo.stackable ? cargo.maxStackLayers : 0;
-  const flexibility = (cargo.canInvert ? 1 : 0) + (cargo.canLayFlat ? 1 : 0);
-  
-  // 评分公式：优先大体积、重货物、可堆叠、灵活性低的货物
-  const score = 
-    volume * 0.4 +           // 体积权重40%
-    weight * 100 * 0.3 +     // 重量权重30%（转换为相同量级）
-    stackability * 1000 * 0.2 + // 堆叠能力权重20%
-    (2 - flexibility) * 500 * 0.1; // 灵活性权重10%（越不灵活越优先）
-  
-  return score;
-}
-
-function sortCargoByStrategy(cargoList) {
-  const expandedCargo = expandCargoQuantity(cargoList);
-  
-  // 按评分降序排序
-  expandedCargo.sort((a, b) => {
-    return calculateCargoScore(b) - calculateCargoScore(a);
-  });
-  
-  return expandedCargo;
-}
-```
-
-#### 排序策略说明
-
-1. **大件优先**: 大体积货物先放置，避免后期出现大件无法放入的情况
-2. **重货优先**: 重货物放在底部，符合物理稳定性要求
-3. **可堆叠优先**: 可堆叠层数高的货物优先，可以作为底层支撑更多货物
-4. **刚性优先**: 旋转限制多的货物优先，避免后期无法满足约束
-
-### 2. 层级堆叠算法
-
-#### 堆叠策略
-
-```javascript
-class LayeredPackingStrategy {
-  constructor(containerType) {
-    this.containerType = containerType;
-    this.layers = [];  // 记录每一层的信息
-    this.currentLayer = 0;
-  }
-  
-  // 尝试在当前层放置货物
-  tryPlaceInCurrentLayer(cargo, rotation, freeRectangles) {
-    // 筛选当前层的空闲矩形
-    const layerRects = freeRectangles.filter(rect => {
-      return rect.z === this.getCurrentLayerHeight();
-    });
-    
-    // 按底面积匹配度排序（最紧密匹配优先）
-    layerRects.sort((a, b) => {
-      const areaA = a.length * a.width;
-      const areaB = b.length * b.width;
-      const cargoArea = rotation.length * rotation.width;
-      
-      const wasteA = Math.abs(areaA - cargoArea);
-      const wasteB = Math.abs(areaB - cargoArea);
-      
-      return wasteA - wasteB;
-    });
-    
-    return layerRects[0] || null;
-  }
-  
-  // 开始新层
-  startNewLayer(height) {
-    this.layers.push({
-      level: this.currentLayer,
-      baseHeight: this.getCurrentLayerHeight(),
-      maxHeight: height,
-      cargo: []
-    });
-    this.currentLayer++;
-  }
-  
-  // 获取当前层高度
-  getCurrentLayerHeight() {
-    if (this.layers.length === 0) return 0;
-    const lastLayer = this.layers[this.layers.length - 1];
-    return lastLayer.baseHeight + lastLayer.maxHeight;
-  }
-  
-  // 检查是否可以在当前层堆叠
-  canStackInLayer(cargo, position, rotation, placedCargo) {
-    // 查找下方支撑货物
-    const supports = this.findSupports(position, rotation, placedCargo);
-    
-    if (supports.length === 0) {
-      // 必须在地面或新层的底部
-      return position.z === 0 || position.z === this.getCurrentLayerHeight();
-    }
-    
-    // 检查所有支撑货物的堆叠能力
-    for (let support of supports) {
-      if (!support.cargo.stackable) return false;
-      
-      const stackLayers = this.countLayersAbove(support, placedCargo);
-      if (stackLayers >= support.cargo.maxStackLayers) return false;
-    }
-    
-    // 检查支撑面积比例
-    const supportArea = this.calculateTotalSupportArea(position, rotation, supports);
-    const cargoArea = rotation.length * rotation.width;
-    const supportRatio = supportArea / cargoArea;
-    
-    // 要求至少50%的支撑面积
-    return supportRatio >= 0.5;
-  }
-  
-  // 查找支撑货物
-  findSupports(position, rotation, placedCargo) {
-    const tolerance = 1; // 1mm容差
-    const supports = [];
-    
-    for (let placed of placedCargo) {
-      const pPos = placed.position;
-      const pRot = placed.rotation;
-      
-      // 检查Z方向接触
-      const zDiff = Math.abs(position.z - (pPos.z + pRot.height));
-      if (zDiff > tolerance) continue;
-      
-      // 检查XY平面重叠
-      const overlapX = !(position.x + rotation.length <= pPos.x || 
-                        pPos.x + pRot.length <= position.x);
-      const overlapY = !(position.y + rotation.width <= pPos.y || 
-                        pPos.y + pRot.width <= position.y);
-      
-      if (overlapX && overlapY) {
-        supports.push(placed);
-      }
-    }
-    
-    return supports;
-  }
-  
-  // 计算总支撑面积
-  calculateTotalSupportArea(position, rotation, supports) {
-    let totalArea = 0;
-    
-    for (let support of supports) {
-      const pPos = support.position;
-      const pRot = support.rotation;
-      
-      // 计算重叠矩形面积
-      const x1 = Math.max(position.x, pPos.x);
-      const x2 = Math.min(position.x + rotation.length, pPos.x + pRot.length);
-      const y1 = Math.max(position.y, pPos.y);
-      const y2 = Math.min(position.y + rotation.width, pPos.y + pRot.width);
-      
-      if (x2 > x1 && y2 > y1) {
-        totalArea += (x2 - x1) * (y2 - y1);
-      }
-    }
-    
-    return totalArea;
-  }
-  
-  // 计算上方层数
-  countLayersAbove(placed, allPlaced) {
-    const above = allPlaced.filter(p => {
-      return this.isDirectlyAbove(p.position, p.rotation, 
-                                   placed.position, placed.rotation);
-    });
-    
-    if (above.length === 0) return 0;
-    
-    let maxLayers = 0;
-    for (let a of above) {
-      const layers = this.countLayersAbove(a, allPlaced);
-      maxLayers = Math.max(maxLayers, layers + 1);
-    }
-    
-    return maxLayers;
-  }
-  
-  // 检查是否在正上方
-  isDirectlyAbove(posA, rotA, posB, rotB) {
-    const tolerance = 1;
-    const zDiff = Math.abs(posA.z - (posB.z + rotB.height));
-    if (zDiff > tolerance) return false;
-    
-    const overlapX = !(posA.x + rotA.length <= posB.x || 
-                      posB.x + rotB.length <= posA.x);
-    const overlapY = !(posA.y + rotA.width <= posB.y || 
-                      posB.y + rotB.width <= posA.y);
-    
-    return overlapX && overlapY;
-  }
-}
-```
