-_optimizeLayerHeight(layer, plan) {
-  // Find actual maximum height used in this layer
-  const layerItems = plan.loadedCargo.filter(l => l.layer === layer.name);
-  
-  if (layerItems.length === 0) {
-    return;
-  }
-  
-  let maxUsedHeight = 0;
-  layerItems.forEach(item => {
-    const topZ = item.position.z + item.rotation.height;
-    const relativeHeight = topZ - layer.zStart;
-    maxUsedHeight = Math.max(maxUsedHeight, relativeHeight);
-  });
-  
-  // Update layer height to actual used height + 50mm clearance
-  const optimizedHeight = maxUsedHeight + 50;
-  
-  // Only reduce height, never increase
-  if (optimizedHeight < layer.maxHeight) {
-    const savedSpace = layer.maxHeight - optimizedHeight;
-    console.log(`  Optimized ${layer.name}: ${layer.maxHeight}mm → ${optimizedHeight}mm (saved ${savedSpace}mm)`);
-    layer.maxHeight = optimizedHeight;
-  }
-}
