-## Data Models
-
-### 数据库表结构设计
-
-#### 1. 货物信息表（cargo）
-
-```sql
-CREATE TABLE cargo (
-  cargo_id VARCHAR(50) PRIMARY KEY COMMENT '货物ID',
-  user_id VARCHAR(50) COMMENT '用户ID（MVP阶段可为空）',
-  name VARCHAR(100) NOT NULL COMMENT '货物名称',
-  length INT NOT NULL COMMENT '长度（毫米）',
-  width INT NOT NULL COMMENT '宽度（毫米）',
-  height INT NOT NULL COMMENT '高度（毫米）',
-  weight DECIMAL(10,2) NOT NULL COMMENT '重量（千克）',
-  quantity INT NOT NULL COMMENT '数量',
-  stackable BOOLEAN DEFAULT TRUE COMMENT '是否可堆叠',
-  max_stack_layers INT DEFAULT 999 COMMENT '最大堆叠层数',
-  can_invert BOOLEAN DEFAULT TRUE COMMENT '是否可倒置',
-  can_lay_flat BOOLEAN DEFAULT TRUE COMMENT '是否可侧放',
-  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
-  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
-  INDEX idx_user_id (user_id),
-  INDEX idx_created_at (created_at)
-) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='货物信息表';
-```
-
-#### 2. 柜型参数表（container_type）
-
-```sql
-CREATE TABLE container_type (
-  type_id VARCHAR(20) PRIMARY KEY COMMENT '柜型ID',
-  name VARCHAR(50) NOT NULL COMMENT '柜型名称',
-  inner_length INT NOT NULL COMMENT '内部长度（毫米）',
-  inner_width INT NOT NULL COMMENT '内部宽度（毫米）',
-  inner_height INT NOT NULL COMMENT '内部高度（毫米）',
-  max_weight INT NOT NULL COMMENT '额定载重（千克）',
-  description TEXT COMMENT '适用场景描述',
-  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间'
-) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='柜型参数表';
-
--- 初始化宁波港标准柜型数据
