-## 核心算法设计
-
-### 1. 堆叠规则算法
-
-```javascript
-/**
- * 在同一批次内按货物类型排序
- * 排序规则：重货 → 普通货 → 易碎品
- */
-function sortCargoByType(cargoList) {
-  return cargoList.sort((a, b) => {
-    const typeOrder = { heavy: 1, normal: 2, fragile: 3 };
-    const typeA = a.getCargoType();
-    const typeB = b.getCargoType();
-    return typeOrder[typeA] - typeOrder[typeB];
-  });
-}
-
-/**
- * 应用堆叠规则
- * 1. 同一批次内，按类型排序后装载
- * 2. 易碎品上方禁止堆叠
- * 3. 重货不叠在轻货或易碎品上方
- */
-function applyStackingRules(batch, containerType) {
-  // 按类型排序：重货 → 普通货 → 易碎品
-  const sortedBatch = sortCargoByType(batch);
-  
-  let currentZ = 0;
-  let currentY = 0;
-  let currentX = batchStartX;
-  let currentLayerMaxHeight = 0;
-  
-  for (const cargo of sortedBatch) {
-    for (let i = 0; i < cargo.quantity; i++) {
-      // 检查Z轴是否需要换行
-      if (currentZ + cargo.width > containerType.innerWidth) {
-        currentZ = 0;
-        currentY += currentLayerMaxHeight;
-        currentLayerMaxHeight = 0;
-      }
-      
-      // 检查Y轴是否超出容器高度
-      if (currentY + cargo.height > containerType.innerHeight) {
-        currentY = 0;
-        currentZ = 0;
-        currentX += cargo.length;
-        currentLayerMaxHeight = 0;
-      }
-      
-      // 【关键】易碎品检查：如果当前货物是易碎品，确保上方无货物
-      if (cargo.isFragile()) {
-        // 易碎品放置在当前层的顶部，不再向上堆叠
-        // 标记为"禁止堆叠"
-      }
-      
-      // 放置货物
-      placeCargoAt(cargo, currentX, currentY, currentZ);
-      
-      // 更新位置
-      currentZ += cargo.width;
-      currentLayerMaxHeight = Math.max(currentLayerMaxHeight, cargo.height);
-    }
-  }
-}
-```
-
-### 2. 边框渲染算法
-
-```javascript
-/**
- * 为货物添加边框
- * @param {THREE.Mesh} mesh - 货物Mesh对象
- * @param {string} cargoType - 货物类型（'heavy'/'fragile'/'normal'）
- */
-function addBorderToMesh(mesh, cargoType) {
-  if (cargoType === 'normal') {
-    // 普通货无边框
-    return;
-  }
-  
-  // 创建边框几何体
-  const edges = new THREE.EdgesGeometry(mesh.geometry);
-  
-  // 根据货物类型选择边框材质
-  let borderMaterial;
-  if (cargoType === 'fragile') {
-    // 易碎品：黄色细边框（1px）
-    borderMaterial = new THREE.LineBasicMaterial({
-      color: 0xffff00,  // 黄色
-      linewidth: 1,
-      opacity: 1.0,
-      transparent: false
-    });
-  } else if (cargoType === 'heavy') {
-    // 重货：黑色粗边框（2px）
-    borderMaterial = new THREE.LineBasicMaterial({
-      color: 0x000000,  // 黑色
-      linewidth: 2,
-      opacity: 1.0,
-      transparent: false
-    });
-  }
-  
-  // 创建边框线段
-  const borderLines = new THREE.LineSegments(edges, borderMaterial);
-  
-  // 将边框添加到货物Mesh
-  mesh.add(borderLines);
-}
-```
-
-### 3. 图标渲染算法
-
-```javascript
-/**
- * 为货物添加图标
- * @param {THREE.Mesh} mesh - 货物Mesh对象
- * @param {string} cargoType - 货物类型（'heavy'/'fragile'/'normal'）
- * @param {Object} cargoDimensions - 货物尺寸 {l, h, w}
- */
-function addIconToMesh(mesh, cargoType, cargoDimensions) {
-  if (cargoType === 'normal') {
-    // 普通货无图标
-    return;
-  }
-  
-  // 确定图标文字
-  let iconText;
-  if (cargoType === 'fragile') {
-    iconText = '易碎';
-  } else if (cargoType === 'heavy') {
-    iconText = '重';
-  }
-  
-  // 根据货物尺寸计算字体大小
-  const minDimension = Math.min(cargoDimensions.l, cargoDimensions.h, cargoDimensions.w);
-  const fontSize = Math.max(minDimension * 0.3, 50);  // 最小50mm
-  
-  // 创建Canvas纹理（微信小程序兼容方案）
-  const canvas = wx.createOffscreenCanvas({ type: '2d', width: 256, height: 256 });
-  const ctx = canvas.getContext('2d');
-  
-  // 绘制文字
-  ctx.fillStyle = '#ffffff';  // 白色
-  ctx.font = `bold ${fontSize}px sans-serif`;
-  ctx.textAlign = 'center';
-  ctx.textBaseline = 'middle';
-  ctx.fillText(iconText, 128, 128);
-  
-  // 创建纹理
-  const texture = new THREE.CanvasTexture(canvas);
-  
-  // 创建Sprite
-  const spriteMaterial = new THREE.SpriteMaterial({
-    map: texture,
-    transparent: true,
-    opacity: 1.0
-  });
-  const sprite = new THREE.Sprite(spriteMaterial);
-  
-  // 设置Sprite大小和位置（放在货物正面）
-  sprite.scale.set(cargoDimensions.l * 0.8, cargoDimensions.h * 0.8, 1);
-  sprite.position.set(0, 0, cargoDimensions.w / 2 + 1);  // 略微前移，避免Z-fighting
-  
-  // 将Sprite添加到货物Mesh
-  mesh.add(sprite);
-}
-```
