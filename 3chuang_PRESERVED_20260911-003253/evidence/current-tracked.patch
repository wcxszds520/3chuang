-### 5. 重心和偏载计算
-
-#### 重心计算
-
-```javascript
-function calculateCenterOfGravity(plan) {
-  if (plan.loadedCargo.length === 0) {
-    return { x: 0, y: 0, z: 0 };
-  }
-  
-  let totalWeight = 0;
-  let weightedX = 0, weightedY = 0, weightedZ = 0;
-  
-  for (let loaded of plan.loadedCargo) {
-    const cargo = loaded.cargo;
-    const pos = loaded.position;
-    const rot = loaded.rotation;
-    
-    // 计算货物几何中心
-    const centerX = pos.x + rot.length / 2;
-    const centerY = pos.y + rot.width / 2;
-    const centerZ = pos.z + rot.height / 2;
-    
-    // 加权累加
-    totalWeight += cargo.weight;
-    weightedX += cargo.weight * centerX;
-    weightedY += cargo.weight * centerY;
-    weightedZ += cargo.weight * centerZ;
-  }
-  
-  return {
-    x: parseFloat((weightedX / totalWeight).toFixed(2)),
-    y: parseFloat((weightedY / totalWeight).toFixed(2)),
-    z: parseFloat((weightedZ / totalWeight).toFixed(2))
-  };
-}
-```
-
-#### 偏载检测
-
-```javascript
-function calculateLoadDistribution(plan, containerType) {
-  const centerX = containerType.innerLength / 2;
-  const centerY = containerType.innerWidth / 2;
-  
-  let frontWeight = 0, backWeight = 0;
-  let leftWeight = 0, rightWeight = 0;
-  let totalWeight = 0;
-  
-  for (let loaded of plan.loadedCargo) {
-    const cargo = loaded.cargo;
-    const pos = loaded.position;
-    const rot = loaded.rotation;
-    
-    const cargoCenterX = pos.x + rot.length / 2;
-    const cargoCenterY = pos.y + rot.width / 2;
-    
-    totalWeight += cargo.weight;
-    
-    // 前后分区（X轴）
-    if (cargoCenterX < centerX) {
-      backWeight += cargo.weight;
-    } else {
-      frontWeight += cargo.weight;
-    }
-    
-    // 左右分区（Y轴）
-    if (cargoCenterY < centerY) {
-      leftWeight += cargo.weight;
-    } else {
-      rightWeight += cargo.weight;
-    }
-  }
-  
-  const frontPercent = (frontWeight / totalWeight) * 100;
-  const backPercent = (backWeight / totalWeight) * 100;
-  const leftPercent = (leftWeight / totalWeight) * 100;
-  const rightPercent = (rightWeight / totalWeight) * 100;
-  
-  const frontBackImbalance = Math.abs(frontWeight - backWeight) / totalWeight * 100;
-  const leftRightImbalance = Math.abs(leftWeight - rightWeight) / totalWeight * 100;
-  
-  return {
-    front: parseFloat(frontWeight.toFixed(2)),
-    back: parseFloat(backWeight.toFixed(2)),
-    left: parseFloat(leftWeight.toFixed(2)),
-    right: parseFloat(rightWeight.toFixed(2)),
-    frontPercent: parseFloat(frontPercent.toFixed(2)),
-    backPercent: parseFloat(backPercent.toFixed(2)),
-    leftPercent: parseFloat(leftPercent.toFixed(2)),
-    rightPercent: parseFloat(rightPercent.toFixed(2)),
-    frontBackImbalance: parseFloat(frontBackImbalance.toFixed(2)),
-    leftRightImbalance: parseFloat(leftRightImbalance.toFixed(2)),
-    frontBackWarning: frontBackImbalance > 10,
-    leftRightWarning: leftRightImbalance > 10
-  };
-}
-```
