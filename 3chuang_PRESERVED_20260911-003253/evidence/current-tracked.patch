-### 2. ThreeRenderer Material Management
-
-#### Problem Analysis
-
-**Current Issue**: Updating `material.opacity` and `material.transparent` on 500+ meshes causes lag because:
-1. Each property change triggers WebGL state updates
-2. Transparency sorting is expensive (O(n log n) per frame)
-3. Material property changes invalidate GPU caches
-
-**Solution Strategy**: Batch updates + shared material references
-
-#### Material Architecture
-
-```javascript
-// In ThreeRenderer.js
-
-constructor() {
-  // ... existing properties
-  this.materialCache = new Map(); // Cache materials by color
-  this.cargoMeshes = [];          // Track all cargo meshes
-}
-
-/**
- * Create or retrieve cached material
- * @param {string} color - Hex color string
- * @returns {THREE.MeshStandardMaterial}
- */
-getCachedMaterial(color) {
-  if (!this.materialCache.has(color)) {
-    const material = new this.THREE.MeshStandardMaterial({
-      color: new this.THREE.Color(color),
-      roughness: 0.5,
-      metalness: 0.1,
-      transparent: true,  // Always true for flexibility
-      opacity: 1.0,
-      depthWrite: true
-    });
-    this.materialCache.set(color, material);
-  }
-  return this.materialCache.get(color);
-}
-```
-
-#### Rendering with Shared Materials
-
-```javascript
-renderIndustrialCargo(cargo, index) {
-  const { x, y, z, l, h, w, color, name, sku } = cargo;
-  
-  // Use cached material instead of creating new one
-  const material = this.getCachedMaterial(color || '#808080');
-  
-  const geometry = new this.THREE.BoxGeometry(l, h, w);
-  const mesh = new this.THREE.Mesh(geometry, material);
-  mesh.position.set(x + l / 2, y + h / 2, z + w / 2);
-  
-  // Store complete metadata in userData
-  mesh.userData = {
-    cargoId: cargo.cargoId || `cargo_${index}`,
-    loadingIndex: cargo.loadingIndex || index,
-    name: name || sku || 'Unknown',
-    sku: sku,
-    dimensions: { l, w, h },
-    weight: cargo.weight,
-    batch: cargo.batchKey || cargo.batch,
-    type: cargo.type || 'normal',
-    color: color,
-    position: { x, y, z }
-  };
-  
-  // Track mesh for visibility updates
-  this.cargoMeshes.push(mesh);
-  
-  // Add edges (existing code)
-  const edgesGeometry = new this.THREE.EdgesGeometry(geometry);
-  const edgesMaterial = new this.THREE.LineBasicMaterial({
-    color: 0x333333,
-    linewidth: 1.0
-  });
-  const edgesMesh = new this.THREE.LineSegments(edgesGeometry, edgesMaterial);
-  edgesMesh.position.copy(mesh.position);
-  edgesMesh.userData = { ...mesh.userData, isEdge: true };
-  
-  this.cargoGroup.add(mesh);
-  this.cargoGroup.add(edgesMesh);
-}
-```
-
-#### Ghost Transparency Mode Implementation
-
-```javascript
-/**
- * Update SKU visibility with ghost transparency
- * @param {Array<string>} selectedSkus - Array of selected SKU names
- */
-updateSkuVisibility(selectedSkus) {
-  console.log('[ThreeRenderer] updateSkuVisibility:', selectedSkus);
-  
-  if (!this.cargoGroup || !this.cargoMeshes) {
-    console.warn('[ThreeRenderer] cargoGroup or cargoMeshes not initialized');
-    return;
-  }
-  
-  // Performance optimization: batch material updates
-  const startTime = Date.now();
-  
-  // If no SKUs selected, show all at full opacity
-  if (selectedSkus.length === 0) {
-    this.cargoMeshes.forEach(mesh => {
-      mesh.material.opacity = 1.0;
-      mesh.material.depthWrite = true;
-      mesh.visible = true;
-    });
-    this.needsRender = true;
-    console.log(`[ThreeRenderer] Reset all visibility in ${Date.now() - startTime}ms`);
-    return;
-  }
-  
-  // Apply ghost transparency mode
-  let selectedCount = 0;
-  let ghostCount = 0;
-  
-  this.cargoMeshes.forEach(mesh => {
-    const meshSkuName = mesh.userData.name || mesh.userData.sku || 'Unknown';
-    const isSelected = selectedSkus.includes(meshSkuName);
-    
-    if (isSelected) {
-      // Selected: Full opacity, write to depth buffer
-      mesh.material.opacity = 1.0;
-      mesh.material.depthWrite = true;
-      mesh.visible = true;
-      selectedCount++;
-    } else {
-      // Unselected: Ghost mode (semi-transparent, no depth write)
-      mesh.material.opacity = 0.15;
-      mesh.material.depthWrite = false;
-      mesh.visible = true;  // Keep visible for spatial reference
-      ghostCount++;
-    }
-  });
-  
-  this.needsRender = true;
-  
-  const elapsed = Date.now() - startTime;
-  console.log(`[ThreeRenderer] Updated ${selectedCount} selected, ${ghostCount} ghost in ${elapsed}ms`);
-  
-  // Performance warning if update takes too long
-  if (elapsed > 100) {
-    console.warn(`[ThreeRenderer] PERFORMANCE WARNING: Visibility update took ${elapsed}ms`);
-  }
-}
-```
-
-#### Performance Optimization Notes
-
-1. **Shared Materials**: All meshes with the same color share one material instance
-2. **Batch Updates**: All opacity changes happen in one loop, then single render
-3. **Depth Write Control**: `depthWrite=false` for ghost items prevents z-fighting
-4. **Visibility Preservation**: Ghost items remain `visible=true` for spatial context
-5. **Performance Monitoring**: Log warnings if updates exceed 100ms threshold
-
-### 3. Raycaster System for Touch Events
-
-#### The WeChat Touch Event Challenge
-
-**Problem**: WeChat Mini Program doesn't have standard DOM mouse events. Touch events provide coordinates in a different format:
-
-```javascript
-// WeChat touch event structure
-{
-  touches: [{
-    x: 150,        // Pixels from left edge
-    y: 200,        // Pixels from top edge
-    clientX: 150,
-    clientY: 200
-  }]
-}
-```
-
-**Three.js Raycaster expects**: Normalized Device Coordinates (NDC) ranging from -1 to +1:
-- (-1, -1) = bottom-left corner
-- (1, 1) = top-right corner
-- (0, 0) = center
-
-#### Coordinate Mapping Function
-
-```javascript
-/**
- * Convert WeChat touch coordinates to Three.js NDC
- * @param {number} touchX - Touch X in pixels
- * @param {number} touchY - Touch Y in pixels
- * @param {number} canvasWidth - Canvas width in pixels
- * @param {number} canvasHeight - Canvas height in pixels
- * @returns {Object} { x, y } in NDC space (-1 to +1)
- */
-touchToNDC(touchX, touchY, canvasWidth, canvasHeight) {
-  // Convert to NDC: (0,0) at top-left → (-1,1) at top-left
-  const ndcX = (touchX / canvasWidth) * 2 - 1;
-  const ndcY = -(touchY / canvasHeight) * 2 + 1;  // Flip Y axis
-  
-  return { x: ndcX, y: ndcY };
-}
-```
-
-#### Raycaster Implementation
-
-```javascript
-// In ThreeRenderer.js
-
-constructor() {
-  // ... existing properties
-  this.raycaster = null;
-  this.mouse = null;
-}
-
-async init(canvas, width, height) {
-  // ... existing init code
-  
-  // Initialize raycaster
-  this.raycaster = new this.THREE.Raycaster();
-  this.mouse = new this.THREE.Vector2();
-  
-  return true;
-}
-
-/**
- * Detect clicked cargo using raycaster
- * @param {number} touchX - Touch X coordinate in pixels
- * @param {number} touchY - Touch Y coordinate in pixels
- * @param {number} canvasWidth - Canvas width in pixels
- * @param {number} canvasHeight - Canvas height in pixels
- * @returns {Object|null} Cargo userData or null
- */
-detectCargoClick(touchX, touchY, canvasWidth, canvasHeight) {
-  if (!this.raycaster || !this.cargoGroup) {
-    console.error('[ThreeRenderer] Raycaster or cargoGroup not initialized');
-    return null;
-  }
-  
-  // Convert touch coordinates to NDC
-  const ndc = this.touchToNDC(touchX, touchY, canvasWidth, canvasHeight);
-  this.mouse.set(ndc.x, ndc.y);
-  
-  console.log('[ThreeRenderer] Touch:', { touchX, touchY }, 'NDC:', ndc);
-  
-  // Update raycaster with camera and mouse position
-  this.raycaster.setFromCamera(this.mouse, this.camera);
-  
-  // Get all cargo meshes (exclude edges and other objects)
-  const cargoMeshes = this.cargoGroup.children.filter(child => 
-    child.userData && child.userData.cargoId && !child.userData.isEdge
-  );
-  
-  // Perform intersection test
-  const intersects = this.raycaster.intersectObjects(cargoMeshes, false);
-  
-  if (intersects.length > 0) {
-    const clickedMesh = intersects[0].object;
-    console.log('[ThreeRenderer] Cargo clicked:', clickedMesh.userData);
-    
-    // Return formatted cargo data
-    return {
-      loadingIndex: clickedMesh.userData.loadingIndex,
-      cargoName: clickedMesh.userData.name,
-      skuId: clickedMesh.userData.sku,
-      dimensions: clickedMesh.userData.dimensions,
-      weight: clickedMesh.userData.weight,
-      batchKey: clickedMesh.userData.batch,
-      type: clickedMesh.userData.type,
-      position: clickedMesh.userData.position
-    };
-  }
-  
-  console.log('[ThreeRenderer] No cargo clicked');
-  return null;
-}
-```
-
-#### Touch Event Handler in packing-result.js
-
-```javascript
-// In packing-result.js Page definition
-
-onCanvasTap(e) {
-  console.log('[PackingResult] Canvas tapped:', e);
-  
-  if (!this.threeRenderer) {
-    console.error('[PackingResult] ThreeRenderer not initialized');
-    return;
-  }
-  
-  // Extract touch coordinates
-  const touch = e.touches && e.touches.length > 0 
-    ? e.touches[0] 
-    : e.changedTouches[0];
-  
-  if (!touch) {
-    console.error('[PackingResult] No touch data');
-    return;
-  }
-  
-  const x = touch.x;
-  const y = touch.y;
-  
-  console.log('[PackingResult] Touch coordinates:', { 
-    x, y, 
-    canvasWidth: this.data.canvasWidth, 
-    canvasHeight: this.data.canvasHeight 
-  });
-  
-  // Detect clicked cargo
-  const cargoData = this.threeRenderer.detectCargoClick(
-    x, y, 
-    this.data.canvasWidth, 
-    this.data.canvasHeight
-  );
-  
-  if (cargoData) {
-    this.displayCargoInspector(cargoData);
-  }
-}
-```
