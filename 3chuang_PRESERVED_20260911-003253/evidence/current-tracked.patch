-### 4. 真实空间利用率计算
-
-#### 基于实际位置的体积计算
-
-```javascript
-function calculateActualSpaceUtilization(plan, containerType) {
-  // 计算集装箱总体积
-  const containerVolume = 
-    containerType.innerLength * 
-    containerType.innerWidth * 
-    containerType.innerHeight;
-  
-  // 累加所有已装载货物的实际体积
-  let occupiedVolume = 0;
-  for (let loaded of plan.loadedCargo) {
-    const cargo = loaded.cargo;
-    // 使用货物的原始尺寸计算体积（不考虑旋转）
-    const cargoVolume = cargo.length * cargo.width * cargo.height;
-    occupiedVolume += cargoVolume;
-  }
-  
-  // 计算空间利用率百分比，精确到小数点后两位
-  const utilization = (occupiedVolume / containerVolume) * 100;
-  return parseFloat(utilization.toFixed(2));
-}
-```
