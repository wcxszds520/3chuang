-### 2. ShippingTimePackingEngine（新建）
-
-新建`backend/services/ShippingTimePackingEngine.js`，实现出货时间驱动的装柜顺序算法：
-
-```javascript
-class ShippingTimePackingEngine {
-  constructor() {
-    this.MODE_SMART_ETA = 'smart_eta';           // 智能出货时间模式
-    this.MODE_CY_CLOSING = 'cy_closing';         // 截关时间优先模式
-    this.MODE_CUSTOM = 'custom';                 // 自定义优先级模式
-  }
-  
-  /**
-   * 计算卸货顺序
-   * @param {Array} cargoList - 货物列表
-   * @returns {Array} 带unloadingOrder的货物列表
-   */
-  calculateUnloadingOrder(cargoList) {
-    // 按ETA和Port_Sequence升序排序
-    const sorted = [...cargoList].sort((a, b) => {
-      // 优先按Port_Sequence排序
-      if (a.portSequence !== b.portSequence) {
-        return a.portSequence - b.portSequence;
-      }
-      // 相同Port_Sequence，按ETA排序
-      return a.eta.getTime() - b.eta.getTime();
-    });
-    
-    // 分配unloadingOrder（1, 2, 3, ...）
-    sorted.forEach((cargo, index) => {
-      cargo.unloadingOrder = index + 1;
-    });
-    
-    return sorted;
-  }
-  
-  /**
-   * 生成装柜顺序（卸货顺序的反向）
-   * @param {Array} cargoList - 带unloadingOrder的货物列表
-   * @returns {Array} 带packingOrder的货物列表
-   */
-  generatePackingOrder(cargoList) {
-    const maxUnloadingOrder = Math.max(...cargoList.map(c => c.unloadingOrder));
-    
-    cargoList.forEach(cargo => {
-      // packingOrder = maxUnloadingOrder - unloadingOrder + 1
-      cargo.packingOrder = maxUnloadingOrder - cargo.unloadingOrder + 1;
-    });
-    
-    // 按packingOrder升序排序（先装的在前）
-    return cargoList.sort((a, b) => a.packingOrder - b.packingOrder);
-  }
-  
-  /**
-   * 截关时间优先模式
-   * @param {Array} cargoList - 货物列表
-   * @returns {Array} 按CY_Closing排序的货物列表
-   */
-  sortByCYClosing(cargoList) {
-    return [...cargoList].sort((a, b) => {
-      // 没有CY_Closing的货物排在后面
-      if (!a.cyClosing) return 1;
-      if (!b.cyClosing) return -1;
-      return a.cyClosing.getTime() - b.cyClosing.getTime();
-    });
-  }
-  
-  /**
-   * 检测出货时间顺序与物理约束的冲突
-   * @param {Array} cargoList - 货物列表
-   * @param {Object} packingPlan - 装箱方案
-   * @returns {Object} 冲突检测结果
-   */
-  detectConflicts(cargoList, packingPlan) {
-    const conflicts = [];
-    
-    // 检查重货是否在轻货上方
-    for (let i = 0; i < packingPlan.loadedCargo.length; i++) {
-      const cargo1 = packingPlan.loadedCargo[i];
-      
-      for (let j = 0; j < packingPlan.loadedCargo.length; j++) {
-        if (i === j) continue;
-        const cargo2 = packingPlan.loadedCargo[j];
-        
-        // 如果cargo1在cargo2上方，且cargo1更重
-        if (cargo1.position.y > cargo2.position.y && 
-            cargo1.cargo.weight > cargo2.cargo.weight) {
-          conflicts.push({
-            type: 'heavy_on_light',
-            cargo1: cargo1.cargo.name,
-            cargo2: cargo2.cargo.name,
-            suggestion: `建议将${cargo1.cargo.name}（${cargo1.cargo.weight}kg）放在${cargo2.cargo.name}（${cargo2.cargo.weight}kg）下方`
-          });
-        }
-      }
-    }
-    
-    return {
-      hasConflicts: conflicts.length > 0,
-      conflicts: conflicts
-    };
-  }
-}
-```
