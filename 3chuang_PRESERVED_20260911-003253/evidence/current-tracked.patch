-      weight: this.validateWeight(packingPlan, containerType),
-      stacking: this.validateStacking(packingPlan),
-      cyClosing: this.validateCYClosing(cargoList),
-      customsDeclaration: this.validateCustomsDeclaration(packingPlan)
