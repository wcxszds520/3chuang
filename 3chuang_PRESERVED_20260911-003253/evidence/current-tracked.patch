-          issue: `堆叠层数${cargo.stackLevel}超过最大限制${cargo.cargo.maxStackLayers}`
-        });
-      }
-    }
-    
-    // 检查重货是否在轻货下方
-    for (let i = 0; i < loadedCargo.length; i++) {
-      const cargo1 = loadedCargo[i];
-      
-      for (let j = 0; j < loadedCargo.length; j++) {
-        if (i === j) continue;
-        const cargo2 = loadedCargo[j];
-        
-        // 如果cargo1在cargo2上方，且cargo1更重
-        if (cargo1.position.y > cargo2.position.y && 
-            cargo1.cargo.weight > cargo2.cargo.weight * 1.5) {  // 1.5倍容差
-          violations.push({
-            cargo1: cargo1.cargo.name,
-            cargo2: cargo2.cargo.name,
