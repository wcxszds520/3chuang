-    // Must be adjacent in at least one axis AND overlap in other two axes
-    if (xAdjacent) {
-      const yOverlap = box1.yMin < box2.yMax && box1.yMax > box2.yMin;
-      const zOverlap = box1.zMin < box2.zMax && box1.zMax > box2.zMin;
-      return yOverlap && zOverlap;
-    }
-    
-    if (yAdjacent) {
-      const xOverlap = box1.xMin < box2.xMax && box1.xMax > box2.xMin;
-      const zOverlap = box1.zMin < box2.zMax && box1.zMax > box2.zMin;
-      return xOverlap && zOverlap;
-    }
-    
-    if (zAdjacent) {
-      const xOverlap = box1.xMin < box2.xMax && box1.xMax > box2.xMin;
-      const yOverlap = box1.yMin < box2.yMax && box1.yMax > box2.yMin;
-      return xOverlap && yOverlap;
-    }
-    
-    return false;
-  }
-
-  // NEW: Check if on left or right side of container
