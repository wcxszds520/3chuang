-    };
-  }
-  
-  /**
-   * 校验截关时间冲突
-   * @param {Array} cargoList - 货物列表
-   * @returns {Object} 校验结果
-   */
-  validateCYClosing(cargoList) {
-    const violations = [];
-    const cargoWithCY = cargoList.filter(c => c.cyClosing);
