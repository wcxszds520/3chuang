-      
-      if (group.length > 1) {
-        // 计算组内货物的平均位置
-        const avgPos = {
-          x: group.reduce((sum, c) => sum + c.position.x, 0) / group.length,
-          y: group.reduce((sum, c) => sum + c.position.y, 0) / group.length,
