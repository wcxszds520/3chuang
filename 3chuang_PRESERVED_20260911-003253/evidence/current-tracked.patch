-## Component Design
-
-### 1. DBLFPackingEngine.js (v25.0.0)
-
-#### 1.1 Surface Attraction Scoring
-
-**Purpose**: Prioritize placement points where cargo has maximum surface contact
-
-**Algorithm**:
-```javascript
-calculateSurfaceAttractionScore(point, rotation, cargo) {
-  let score = 0;
-  const { x, y, z } = point;
-  const { length: l, height: h, width: w } = rotation;
-  
-  // Check bottom face (Y=0 or adjacent cargo below)
-  if (y === 0 || this.hasFullSupport(x, y, z, l, w)) score++;
-  
-  // Check back face (X=0 or adjacent cargo behind)
-  if (x === 0 || this.hasAdjacentSurface(x, y, z, h, w, 'back')) score++;
-  
-  // Check left face (Z=0 or adjacent cargo left)
-  if (z === 0 || this.hasAdjacentSurface(x, y, z, l, h, 'left')) score++;
-  
-  // Check front face (X+l at container wall or adjacent cargo)
-  if (x + l === this.container.length || this.hasAdjacentSurface(x + l, y, z, h, w, 'front')) score++;
-  
-  // Check right face (Z+w at container wall or adjacent cargo)
-  if (z + w === this.container.width || this.hasAdjacentSurface(x, y, z + w, l, h, 'right')) score++;
-  
-  // Check top face (adjacent cargo above - rare but possible)
-  if (this.hasAdjacentSurface(x, y + h, z, l, w, 'top')) score++;
-  
-  return score;
-}
-```
-
-**Integration**: Called in `findBestExtremePointGlobal()` to rank extreme points
-
-#### 1.2 Snap-to-Neighbors Function
-
-**Purpose**: Eliminate 1-5mm gaps by micro-adjusting cargo coordinates
-
-**Algorithm**:
-```javascript
-snapToNeighbors(x, y, z, l, h, w) {
-  let snappedX = x, snappedY = y, snappedZ = z;
-  const SNAP_THRESHOLD = 5; // mm
-  
-  // Snap X coordinate (depth)
-  const nearbyX = this.findNearbyXSurfaces(x, y, z, l, h, w);
-  for (const surface of nearbyX) {
-    const gap = Math.abs(x - surface.x);
-    if (gap > 0 && gap <= SNAP_THRESHOLD) {
-      snappedX = surface.x;
-      break;
-    }
-  }
-  
-  // Snap Y coordinate (height)
-  const nearbyY = this.findNearbyYSurfaces(x, y, z, l, h, w);
-  for (const surface of nearbyY) {
-    const gap = Math.abs(y - surface.y);
-    if (gap > 0 && gap <= SNAP_THRESHOLD) {
-      snappedY = surface.y;
-      break;
-    }
-  }
-  
-  // Snap Z coordinate (width)
-  const nearbyZ = this.findNearbyZSurfaces(x, y, z, l, h, w);
-  for (const surface of nearbyZ) {
-    const gap = Math.abs(z - surface.z);
-    if (gap > 0 && gap <= SNAP_THRESHOLD) {
-      snappedZ = surface.z;
-      break;
-    }
-  }
-  
-  // Verify no collision after snapping
-  if (!this.hasCollision(snappedX, snappedY, snappedZ, l, h, w)) {
-    return { x: snappedX, y: snappedY, z: snappedZ };
-  }
-  
-  return { x, y, z }; // Return original if snap causes collision
-}
-```
-
-
-
-#### 1.3 Incremental CoG Calculation
-
-**Purpose**: Calculate center of gravity efficiently without full recalculation
-
-**Data Structure**:
-```javascript
-this.cogState = {
-  totalWeight: 0,
-  weightedSumX: 0,
-  weightedSumY: 0,
-  weightedSumZ: 0,
-  cogX: 0,
-  cogY: 0,
-  cogZ: 0
-};
-```
-
-**Algorithm**:
-```javascript
-updateCoG(cargo) {
-  // Cargo center point
-  const centerX = cargo.x + cargo.l / 2;
-  const centerY = cargo.y + cargo.h / 2;
-  const centerZ = cargo.z + cargo.w / 2;
-  
-  // Incremental update
-  this.cogState.totalWeight += cargo.weight;
-  this.cogState.weightedSumX += centerX * cargo.weight;
-  this.cogState.weightedSumY += centerY * cargo.weight;
-  this.cogState.weightedSumZ += centerZ * cargo.weight;
-  
-  // Calculate new CoG
-  if (this.cogState.totalWeight > 0) {
-    this.cogState.cogX = this.cogState.weightedSumX / this.cogState.totalWeight;
-    this.cogState.cogY = this.cogState.weightedSumY / this.cogState.totalWeight;
-    this.cogState.cogZ = this.cogState.weightedSumZ / this.cogState.totalWeight;
-  }
-  
-  return {
-    x: this.cogState.cogX,
-    y: this.cogState.cogY,
-    z: this.cogState.cogZ
-  };
-}
-```
-
-**Performance**: O(1) per cargo placement vs O(n) for full recalculation
-
-#### 1.4 Modified Extreme Point Selection
-
-**Purpose**: Integrate surface attraction scoring with existing priority
-
-**Algorithm**:
-```javascript
-findBestExtremePointGlobal(rotation, cargo, cargoType, currentBatchIdx) {
-  // Calculate surface attraction scores for all points
-  const scoredPoints = this.extremePoints.map(point => ({
-    point,
-    attractionScore: this.calculateSurfaceAttractionScore(point, rotation, cargo)
-  }));
-  
-  // Sort by attraction score (descending), then by existing priority
-  const sortedPoints = scoredPoints.sort((a, b) => {
-    // PRIORITY 1: Surface attraction score (higher is better)
-    if (a.attractionScore !== b.attractionScore) {
-      return b.attractionScore - a.attractionScore;
-    }
-    
-    // PRIORITY 2: X-min (depth first)
-    if (Math.abs(a.point.x - b.point.x) > 10) return a.point.x - b.point.x;
-    
-    // PRIORITY 3: Y-min (ground first)
-    if (Math.abs(a.point.y - b.point.y) > 10) return a.point.y - b.point.y;
-    
-    // PRIORITY 4: Z-min (left first)
-    if (Math.abs(a.point.z - b.point.z) > 10) return a.point.z - b.point.z;
-    
-    return 0;
-  });
-  
-  // Try each point with snap-to-neighbors
-  for (const { point } of sortedPoints) {
-    if (this.canPlaceAtPointGlobal(point, rotation, cargo, cargoType, currentBatchIdx)) {
-      // Apply snap-to-neighbors
-      const snapped = this.snapToNeighbors(
-        point.x, point.y, point.z,
-        rotation.length, rotation.height, rotation.width
-      );
-      
-      // Verify snapped position is still valid
-      if (this.canPlaceAtPointGlobal(snapped, rotation, cargo, cargoType, currentBatchIdx)) {
-        return { point: snapped, rotation };
-      }
-      
-      // Fallback to original point if snap fails
-      return { point, rotation };
-    }
-  }
-  
-  return null;
-}
-```
-
-### 2. NingboPortSafetyEngine.js (NEW)
-
-**Purpose**: Validate maritime safety compliance and generate safety reports
-
-#### 2.1 Class Structure
-
-```javascript
-class NingboPortSafetyEngine {
-  constructor() {
-    this.COG_LATERAL_LIMIT = 0.05;  // 5% of width
-    this.COG_LONGITUDINAL_LIMIT = 0.10;  // 10% of length
-    this.OVERWEIGHT_CRITICAL = 1.05;  // 105% of maxWeight
-    this.OVERWEIGHT_WARNING = 1.00;  // 100% of maxWeight
-  }
-  
-  validatePackingPlan(packingPlan, container) {
-    const warnings = [];
-    
-    // CoG validation
-    const cogWarnings = this.validateCoG(packingPlan.cog, container);
-    warnings.push(...cogWarnings);
-    
-    // Weight validation
-    const weightWarnings = this.validateWeight(packingPlan.totalWeight, container.maxWeight);
-    warnings.push(...weightWarnings);
-    
-    // Pressure validation
-    const pressureWarnings = this.validatePressure(packingPlan.loadedCargo);
-    warnings.push(...pressureWarnings);
-    
-    // Determine compliance status
-    const complianceStatus = this.determineComplianceStatus(warnings);
-    
-    return {
-      cog: packingPlan.cog,
-      cogOffset: this.calculateCoGOffset(packingPlan.cog, container),
-      totalWeight: packingPlan.totalWeight,
-      weightUtilization: (packingPlan.totalWeight / container.maxWeight * 100).toFixed(2),
-      warnings,
-      complianceStatus
-    };
-  }
-}
-```
-
-#### 2.2 CoG Validation
-
-```javascript
-validateCoG(cog, container) {
-  const warnings = [];
-  const centerX = container.length / 2;
-  const centerZ = container.width / 2;
-  
-  // Lateral offset (Z-axis)
-  const lateralOffset = Math.abs(cog.z - centerZ) / container.width;
-  if (lateralOffset > this.COG_LATERAL_LIMIT) {
-    const severity = lateralOffset > 0.10 ? 'CRITICAL' : 'WARNING';
-    warnings.push({
-      type: 'COG_OFFSET',
-      severity,
-      message: `横向重心偏移 ${(lateralOffset * 100).toFixed(2)}% 超过限制 (${this.COG_LATERAL_LIMIT * 100}%)`,
-      details: { axis: 'Z', offset: lateralOffset, limit: this.COG_LATERAL_LIMIT }
-    });
-  }
-  
-  // Longitudinal offset (X-axis)
-  const longitudinalOffset = Math.abs(cog.x - centerX) / container.length;
-  if (longitudinalOffset > this.COG_LONGITUDINAL_LIMIT) {
-    const severity = longitudinalOffset > 0.15 ? 'CRITICAL' : 'WARNING';
-    warnings.push({
-      type: 'COG_OFFSET',
-      severity,
-      message: `纵向重心偏移 ${(longitudinalOffset * 100).toFixed(2)}% 超过限制 (${this.COG_LONGITUDINAL_LIMIT * 100}%)`,
-      details: { axis: 'X', offset: longitudinalOffset, limit: this.COG_LONGITUDINAL_LIMIT }
-    });
-  }
-  
-  return warnings;
-}
-```
-
-#### 2.3 Weight Validation
-
-```javascript
-validateWeight(totalWeight, maxWeight) {
-  const warnings = [];
-  const utilization = totalWeight / maxWeight;
-  
-  if (utilization > this.OVERWEIGHT_WARNING) {
-    const severity = utilization > this.OVERWEIGHT_CRITICAL ? 'CRITICAL' : 'WARNING';
-    warnings.push({
-      type: 'OVERWEIGHT',
-      severity,
-      message: `总重量 ${totalWeight.toFixed(2)}kg 超过限制 ${maxWeight}kg (${(utilization * 100).toFixed(2)}%)`,
-      details: { totalWeight, maxWeight, utilization }
-    });
-  }
-  
-  return warnings;
-}
-```
-
-#### 2.4 Pressure Validation
-
-```javascript
-validatePressure(loadedCargo) {
-  const warnings = [];
-  
-  // Find ground-level cargo
-  const groundCargo = loadedCargo.filter(c => c.position.y === 0);
-  
-  for (const bottom of groundCargo) {
-    // Find cargo directly above
-    const cargoAbove = loadedCargo.filter(c => {
-      if (c.position.y <= bottom.position.y) return false;
-      
-      // Check vertical projection overlap
-      return this.hasVerticalOverlap(bottom, c);
-    });
-    
-    // Calculate total weight above
-    const totalWeightAbove = cargoAbove.reduce((sum, c) => sum + c.properties.weight, 0);
-    
-    // Check for heavy cargo on non-heavy cargo
-    const hasHeavyAbove = cargoAbove.some(c => c.properties.type === 'heavy');
-    if (hasHeavyAbove && bottom.properties.type !== 'heavy') {
-      warnings.push({
-        type: 'PRESSURE',
-        severity: 'WARNING',
-        message: `重货压在非重货上 (底部货物: ${bottom.cargoId})`,
-        details: { bottomCargo: bottom.cargoId, weightAbove: totalWeightAbove }
-      });
-    }
-    
-    // Calculate pressure per unit area
-    const bottomArea = bottom.dimensions.l * bottom.dimensions.w;
-    const pressure = totalWeightAbove / bottomArea; // kg/mm²
-    
-    // Pressure threshold (example: 0.01 kg/mm² = 10 kg/cm²)
-    if (pressure > 0.01) {
-      warnings.push({
-        type: 'PRESSURE',
-        severity: 'WARNING',
-        message: `底部货物压强过高 (${pressure.toFixed(4)} kg/mm²)`,
-        details: { cargoId: bottom.cargoId, pressure, area: bottomArea }
-      });
-    }
-  }
-  
-  return warnings;
-}
-```
-
-### 3. ThreeRenderer.js Enhancements
-
-#### 3.1 SKU Color Generation
-
-**Purpose**: Generate deterministic colors based on SKU name hash
-
-```javascript
-generateSKUColor(skuName) {
-  // Check cache first
-  if (this.skuColorCache.has(skuName)) {
-    return this.skuColorCache.get(skuName);
-  }
-  
-  // Generate hash from SKU name
-  const hash = this.hashString(skuName);
-  
-  // Convert hash to HSL
-  const hue = (hash % 360); // 0-360 degrees
-  const saturation = 60 + (hash % 30); // 60-90%
-  const lightness = 40 + (hash % 30); // 40-70%
-  
-  const color = this.hslToRgb(hue, saturation, lightness);
-  
-  // Cache for consistency
-  this.skuColorCache.set(skuName, color);
-  
-  return color;
-}
-
-hashString(str) {
-  let hash = 0;
-  for (let i = 0; i < str.length; i++) {
-    const char = str.charCodeAt(i);
-    hash = ((hash << 5) - hash) + char;
-    hash = hash & hash; // Convert to 32-bit integer
-  }
-  return Math.abs(hash);
-}
-
-hslToRgb(h, s, l) {
-  s /= 100;
-  l /= 100;
-  
-  const c = (1 - Math.abs(2 * l - 1)) * s;
-  const x = c * (1 - Math.abs((h / 60) % 2 - 1));
-  const m = l - c / 2;
-  
-  let r, g, b;
-  if (h < 60) { r = c; g = x; b = 0; }
-  else if (h < 120) { r = x; g = c; b = 0; }
-  else if (h < 180) { r = 0; g = c; b = x; }
-  else if (h < 240) { r = 0; g = x; b = c; }
-  else if (h < 300) { r = x; g = 0; b = c; }
-  else { r = c; g = 0; b = x; }
-  
-  return new this.THREE.Color(r + m, g + m, b + m);
-}
-```
-
-#### 3.2 CoG Crosshair Rendering
-
-**Purpose**: Render red crosshair at CoG position
-
-```javascript
-renderCoGCrosshair(cog) {
-  // Remove existing crosshair
-  if (this.cogCrosshair) {
-    this.scene.remove(this.cogCrosshair);
-    this.disposeGroup(this.cogCrosshair);
-  }
-  
-  this.cogCrosshair = new this.THREE.Group();
-  
-  const crosshairLength = 200; // mm
-  const material = new this.THREE.LineBasicMaterial({
-    color: 0xFF0000, // Red
-    linewidth: 3
-  });
-  
-  // X-axis line (depth)
-  const xGeometry = new this.THREE.Geometry();
-  xGeometry.vertices.push(
-    new this.THREE.Vector3(cog.x - crosshairLength, cog.y, cog.z),
-    new this.THREE.Vector3(cog.x + crosshairLength, cog.y, cog.z)
-  );
-  this.cogCrosshair.add(new this.THREE.Line(xGeometry, material));
-  
-  // Y-axis line (height)
-  const yGeometry = new this.THREE.Geometry();
-  yGeometry.vertices.push(
-    new this.THREE.Vector3(cog.x, cog.y - crosshairLength, cog.z),
-    new this.THREE.Vector3(cog.x, cog.y + crosshairLength, cog.z)
-  );
-  this.cogCrosshair.add(new this.THREE.Line(yGeometry, material));
-  
-  // Z-axis line (width)
-  const zGeometry = new this.THREE.Geometry();
-  zGeometry.vertices.push(
-    new this.THREE.Vector3(cog.x, cog.y, cog.z - crosshairLength),
-    new this.THREE.Vector3(cog.x, cog.y, cog.z + crosshairLength)
-  );
-  this.cogCrosshair.add(new this.THREE.Line(zGeometry, material));
-  
-  // Add center sphere for visibility
-  const sphereGeometry = new this.THREE.SphereGeometry(20, 16, 16);
-  const sphereMaterial = new this.THREE.MeshBasicMaterial({
-    color: 0xFF0000,
-    transparent: true,
-    opacity: 0.8
-  });
-  const sphere = new this.THREE.Mesh(sphereGeometry, sphereMaterial);
-  sphere.position.set(cog.x, cog.y, cog.z);
-  this.cogCrosshair.add(sphere);
-  
-  this.scene.add(this.cogCrosshair);
-  this.needsRender = true;
-}
-```
