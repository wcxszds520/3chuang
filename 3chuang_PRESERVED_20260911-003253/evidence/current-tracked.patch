-    // 计算总分（六个维度的平均分）
-    const overallScore = (
-      results.shippingOrder.score +
-      results.cogOffset.score +
-      results.weight.score +
-      results.stacking.score +
-      results.cyClosing.score +
-      results.customsDeclaration.score
