+.pc-space-stage__bayedge { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; opacity: 0; transition: opacity 440ms var(--ease-out); pointer-events: none; }
+.pc-space-stage__bayedge polygon { fill: none; stroke: rgba(10,111,242,.62); stroke-width: 1.6; stroke-dasharray: 5 4; }
+.pc-space-stage[data-space-active="2"] .pc-space-stage__bayedge,
+.pc-space-stage[data-space-active="3"] .pc-space-stage__bayedge,
+.pc-space-stage[data-space-active="4"] .pc-space-stage__bayedge { opacity: 1; }
+
+/* 浅色剖视窗上的候选块配色（覆盖 v2 蓝底规则）。 */
+.pc-space-stage__envelope .candidate { background: rgba(10,111,242,.1); border: 1px solid rgba(10,111,242,.5); border-bottom-width: 2px; box-shadow: 0 4px 12px rgba(10,31,50,.1); }
+.pc-space-stage[data-space-active="3"] .candidate--selected,
+.pc-space-stage[data-space-active="4"] .candidate--selected { background: #fff; border: 2px solid #0a6ff2; box-shadow: 0 0 0 5px rgba(10,111,242,.12), 0 8px 18px rgba(10,31,50,.16); }
+.pc-space-stage[data-space-active="3"] .candidate:not(.candidate--selected) { background: rgba(255,255,255,.2); border-color: rgba(10,111,242,.42); box-shadow: none; }
+
+/* closeout v4 cutaway stacking — 剖视窗必须盖在箱体素材之上，候选块在浅底上可读。 */
+.pc-space-stage__bay { z-index: 2; }
+.pc-space-stage__bayedge { z-index: 3; }
+.pc-space-stage__floor, .pc-space-stage__baynote { z-index: 3; }
+.pc-space-stage__envelope { z-index: 4; }
+.pc-space-stage__envelope .candidate { background: rgba(10,111,242,.24); border: 1.5px solid rgba(10,111,242,.62); border-bottom-width: 2px; box-shadow: 0 4px 10px rgba(10,31,50,.12); }
+.pc-space-stage[data-space-active="3"] .candidate--selected,
+.pc-space-stage[data-space-active="4"] .candidate--selected { background: #0a6ff2; border: 2px solid #0b416d; box-shadow: 0 0 0 5px rgba(10,111,242,.16), 0 8px 18px rgba(10,31,50,.22); }
+
+.plan-identity { font: 13px var(--font-mono, monospace); color: #38596a; white-space: nowrap; }
+.plan-versions { margin: 0 0 20px; border: 1px solid #c7d4da; border-radius: 8px; background: #fff; }
+.plan-versions summary { padding: 14px 18px; cursor: pointer; font-size: 15px; font-weight: 600; }
