# 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ningbo_port_packing
DB_PORT=3306

# 服务器配置
PORT=3000
NODE_ENV=development

# AI API配置（可选 - 用于AI增强功能）
# 如果不配置，系统会自动降级使用基于规则的默认策略

# 方案1: 硅基流动 + DeepSeek / Qwen（推荐 - 路演级深度推理）
# 真实值只写入 .env / 环境变量，不要提交到代码仓库。
SILICONFLOW_API_KEY=
SILICONFLOW_API_ENDPOINT=
AI_API_KEY=
AI_API_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
AI_MODEL=
SILICONFLOW_VLM_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
AI_TIMEOUT_MS=
VLM_TIMEOUT_MS=
VLM_MAX_ATTEMPTS=
TAVILY_API_KEY=
WEB_RAG_ENABLED=
WEB_RAG_TIMEOUT_MS=
WEB_RAG_CACHE_ENABLED=
WEB_RAG_MAX_RESULTS=

# 方案2: 硅基流动 + Qwen (备选 - 性价比高)
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 方案2: DeepSeek
# AI_API_KEY=your_deepseek_api_key_here
# AI_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# AI_MODEL=deepseek-chat

# 方案3: 通义千问
# AI_API_KEY=your_qwen_api_key_here
# AI_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
# AI_MODEL=qwen-turbo
