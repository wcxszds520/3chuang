/**
 * 打字机效果组件样式
 * Requirements: 8.7 - AI 解释打字机效果
 */

.typewriter {
  display: inline;
  line-height: 1.6;
}

.typewriter__text {
  font-size: var(--font-size-md, 28rpx);
  color: var(--color-text-primary, #1D1D1F);
  line-height: 1.6;
}

.typewriter__cursor {
  display: inline;
  font-weight: 100;
  color: var(--color-primary, #007AFF);
  animation: cursorBlink 800ms steps(2) infinite;
}

@keyframes cursorBlink {
  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}
