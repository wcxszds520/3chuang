# ============================================================
#  只跟踪四个项目目录，其余（同级其他项目/文件）一律忽略
# ============================================================
/*
!/.gitignore
!/README.md
!/3chuang/
!/3chuang_PRESERVED_20260911-003253/
!/3chuang_RECOVERED_20260911-003253/
!/3chuang_RECOVERY_RUN_20260911-003253/

